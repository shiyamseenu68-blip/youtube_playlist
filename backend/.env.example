# Backend Environment Configuration
PORT=5000
NODE_ENV=development

# Allowed CORS Origins (comma-separated for production/staging)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000

# Optional YouTube Authentication Cookies File Path (MUST be a real file path)
# YOUTUBE_COOKIES_FILE=/etc/secrets/cookies.txt

# Temp directory path for job isolation
TEMP_DIR=/tmp/youtube-downloads

# Queue configuration
MAX_CONCURRENT_DOWNLOADS=1
